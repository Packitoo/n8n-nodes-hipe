{
  "name": "Job Lifecycle Example",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 300],
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Manual Trigger"
    },
    {
      "parameters": {
        "resource": "job",
        "operation": "create",
        "type": "n8n_workflow",
        "subType": "={{ $workflow.name }}",
        "externalId": "={{ $execution.id }}",
        "additionalFields": {
          "status": 2,
          "entityType": "company",
          "entityId": "123",
          "metadata": "{\"source\": \"manual_test\"}"
        }
      },
      "type": "@packitoo/n8n-nodes-hipe.hipe",
      "typeVersion": 1,
      "position": [260, 300],
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Create Job",
      "credentials": {
        "hipeApi": {
          "id": "<YOUR_CREDENTIAL_ID>",
          "name": "HIPE API"
        }
      }
    },
    {
      "parameters": {
        "resource": "job",
        "operation": "updateProgress",
        "id": "={{ $json.id }}",
        "completeness": 50,
        "log": {
          "level": "info",
          "message": "Halfway through processing"
        }
      },
      "type": "@packitoo/n8n-nodes-hipe.hipe",
      "typeVersion": 1,
      "position": [520, 160],
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Update Progress 50%",
      "credentials": {
        "hipeApi": {
          "id": "<YOUR_CREDENTIAL_ID>",
          "name": "HIPE API"
        }
      }
    },
    {
      "parameters": {
        "resource": "job",
        "operation": "appendLogs",
        "id": "={{ $json.id }}",
        "completeness": 80,
        "entries": {
          "entryFields": [
            {
              "level": "info",
              "message": "Processing batch 1 of 2"
            },
            {
              "level": "info",
              "message": "Processing batch 2 of 2"
            }
          ]
        }
      },
      "type": "@packitoo/n8n-nodes-hipe.hipe",
      "typeVersion": 1,
      "position": [780, 160],
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Append Logs",
      "credentials": {
        "hipeApi": {
          "id": "<YOUR_CREDENTIAL_ID>",
          "name": "HIPE API"
        }
      }
    },
    {
      "parameters": {
        "resource": "job",
        "operation": "complete",
        "id": "={{ $json.id }}",
        "metadata": "{\"itemsProcessed\": 42}"
      },
      "type": "@packitoo/n8n-nodes-hipe.hipe",
      "typeVersion": 1,
      "position": [1040, 60],
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Complete Job",
      "credentials": {
        "hipeApi": {
          "id": "<YOUR_CREDENTIAL_ID>",
          "name": "HIPE API"
        }
      }
    },
    {
      "parameters": {
        "resource": "job",
        "operation": "fail",
        "id": "={{ $('Create Job').item.json.id }}",
        "error": "{\"message\": \"Import failed: invalid CSV\", \"code\": \"PARSE_ERROR\"}"
      },
      "type": "@packitoo/n8n-nodes-hipe.hipe",
      "typeVersion": 1,
      "position": [1040, 300],
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Fail Job (on error)",
      "credentials": {
        "hipeApi": {
          "id": "<YOUR_CREDENTIAL_ID>",
          "name": "HIPE API"
        }
      }
    },
    {
      "parameters": {
        "resource": "job",
        "operation": "get",
        "id": "={{ $('Create Job').item.json.id }}"
      },
      "type": "@packitoo/n8n-nodes-hipe.hipe",
      "typeVersion": 1,
      "position": [520, 440],
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Get Job",
      "credentials": {
        "hipeApi": {
          "id": "<YOUR_CREDENTIAL_ID>",
          "name": "HIPE API"
        }
      }
    },
    {
      "parameters": {
        "resource": "job",
        "operation": "cancel",
        "id": "={{ $('Create Job').item.json.id }}"
      },
      "type": "@packitoo/n8n-nodes-hipe.hipe",
      "typeVersion": 1,
      "position": [780, 440],
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Cancel Job",
      "credentials": {
        "hipeApi": {
          "id": "<YOUR_CREDENTIAL_ID>",
          "name": "HIPE API"
        }
      }
    },
    {
      "parameters": {
        "resource": "job",
        "operation": "getMany",
        "returnAll": false,
        "limit": 10,
        "page": 1,
        "filters": {
          "type": "n8n_workflow",
          "status": "1"
        },
        "sort": {
          "sortBy": "createdAt",
          "sortOrder": "desc"
        }
      },
      "type": "@packitoo/n8n-nodes-hipe.hipe",
      "typeVersion": 1,
      "position": [260, 540],
      "id": "a1b2c3d4-0009-4000-8000-000000000009",
      "name": "List Jobs",
      "credentials": {
        "hipeApi": {
          "id": "<YOUR_CREDENTIAL_ID>",
          "name": "HIPE API"
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          { "node": "Create Job", "type": "main", "index": 0 },
          { "node": "List Jobs", "type": "main", "index": 0 }
        ]
      ]
    },
    "Create Job": {
      "main": [
        [
          { "node": "Update Progress 50%", "type": "main", "index": 0 },
          { "node": "Get Job", "type": "main", "index": 0 }
        ]
      ]
    },
    "Update Progress 50%": {
      "main": [
        [
          { "node": "Append Logs", "type": "main", "index": 0 }
        ]
      ]
    },
    "Append Logs": {
      "main": [
        [
          { "node": "Complete Job", "type": "main", "index": 0 },
          { "node": "Fail Job (on error)", "type": "main", "index": 0 }
        ]
      ]
    },
    "Get Job": {
      "main": [
        [
          { "node": "Cancel Job", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
